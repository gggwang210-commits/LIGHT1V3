# Local demo template only. Copy to .env; never commit the populated .env file.
# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# seed_lightone reads passwords from these variables unless --generate-passwords is used.
LIGHTONE_DEMO_ADMIN_PASSWORD=
LIGHTONE_DEMO_MEMBER_A_PASSWORD=
LIGHTONE_DEMO_MEMBER_B_PASSWORD=

# Production-only variables are intentionally blank and must be supplied by a secret manager.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
